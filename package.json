{
  "name": "@solercia/eslint-config",
  "version": "0.2.0",
  "type": "module",
  "description": "Preset ESLint compartible (flat config) del ecosistema Solercia: fronteras FSD, ubicación de archivos por capa y segmento, estilos con variables del tema (inline y .css), regla smart/dumb de shared/ui, restricción de Chart.js y convenciones de nombres.",
  "license": "Apache-2.0",
  "author": "Solercia Solutions SAS",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solercia-solutions/eslint-config.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./index.js"
  },
  "peerDependencies": {
    "eslint": "^10.0.0",
    "typescript-eslint": "^8.0.0",
    "@eslint/css": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@eslint/css": {
      "optional": true
    }
  },
  "homepage": "https://github.com/solercia-solutions/eslint-config#readme",
  "bugs": {
    "url": "https://github.com/solercia-solutions/eslint-config/issues"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/css": "2.0.1",
    "eslint": "10.7.0",
    "typescript-eslint": "8.63.0"
  },
  "engines": {
    "node": ">=22.14"
  }
}
